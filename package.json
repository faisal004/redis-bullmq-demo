{
  "name": "redis-bullmq-demo",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "A local document pipeline demo: Redis, BullMQ workers, MongoDB, and visible queue hand-offs.",
  "engines": {
    "node": ">=22.9.0"
  },
  "scripts": {
    "infra": "docker compose up -d --wait",
    "web": "node --env-file-if-exists=.env --import tsx src/server.ts",
    "workers": "node --env-file-if-exists=.env --import tsx src/workers/run.ts",
    "demo": "npm run infra && concurrently --kill-others --names web,workers \"npm run web\" \"npm run workers\"",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test tests/validation.test.ts",
    "test:integration": "node --import tsx --test --test-timeout=60000 tests/pipeline.test.ts"
  },
  "dependencies": {
    "@bull-board/api": "^6.21.3",
    "@bull-board/express": "^6.21.3",
    "bullmq": "^5.81.5",
    "express": "^5.3.0",
    "ioredis": "^5.11.1",
    "mongodb": "^6.22.0"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^22.20.5",
    "concurrently": "^10.0.7",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  }
}
